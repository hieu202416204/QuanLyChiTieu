<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<VBox alignment="TOP_CENTER" spacing="10.0"   style="-fx-padding: 20;
-fx-background-image: url('FrontEnd/Image/BackGround03.png');
-fx-background-size: contain;     -fx-background-repeat: no-repeat;
-fx-background-position: center;" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="FrontEnd.Controllers.HistoryController">
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <Label text="📜 LỊCH SỬ GIAO DỊCH" styleClass="label-title" />
    <Separator />

    <Label fx:id="filterLabel" text="Tất cả giao dịch chi tiêu đã ghi nhận:" styleClass="label-subtitle" />

    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="dateColumn" text="Thời Gian" prefWidth="150.0" minWidth="100.0" />
            <TableColumn fx:id="categoryColumn" text="Danh Mục" prefWidth="120.0" minWidth="80.0" />

            <TableColumn fx:id="purposeColumn" text="Mục Đích" prefWidth="300.0" minWidth="200.0" />

            <TableColumn fx:id="moneyColumn" text="Số Tiền" prefWidth="100.0" minWidth="90.0" style="-fx-alignment: CENTER_RIGHT;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER" style="-fx-padding: 10 0 0 0;">
        <Button text="Đóng" onAction="#handleClose" styleClass="button-close" />
    </HBox>
</VBox>